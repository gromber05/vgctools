# Copia este archivo a .env y cambia los valores.

# Contraseña de la base de datos PostgreSQL (docker compose).
POSTGRES_PASSWORD=cambia-esta-contraseña

# Firma los tokens de sesión. Pon una cadena larga y aleatoria, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
